# Live environment for couchbox-install. This replaces releng's rescue-system
# package list; the target system comes from the offline repo instead.
base
linux
# No firmware: the installer is a console TUI that needs no network, and
# without GPU firmware the console stays on the UEFI framebuffer. Leaving it out
# (about 160 MiB) keeps the ISO under GitHub's 2 GiB release asset limit.
mkinitcpio
mkinitcpio-archiso
# couchbox-install (libnewt: whiptail for the disk picker)
arch-install-scripts
libnewt
dosfstools
e2fsprogs
parted
# Debugging from the console, and remotely when a network happens to be there.
less
nano
openssh
