#!/usr/bin/env bash
# Install couchbox onto a whole disk. ERASES the target disk.
#
#   couchbox-install                          menus: pick the disk, set a password
#   couchbox-install [--yes] [--hostname NAME] [--timezone ZONE] DISK
#
# Layout: GPT, 1 GiB ESP at /boot (systemd-boot), ext4 root on the rest.
# Installs from the offline repo on the ISO, so no network is needed.
set -euo pipefail

hostname=couchbox
timezone=UTC
user=htpc
assume_yes=0
couchbox_repo_url=https://github.com/jpsutton/couchbox/releases/latest/download
offline_dir=/var/lib/couchbox/offline  # everything the install needs
target_list=/etc/couchbox/target-packages

usage() { sed -n '2,7s/^# \{0,1\}//p' "$0"; exit "${1:-0}"; }
die() { echo "couchbox-install: $*" >&2; exit 1; }

# whiptail writes the choice to stderr; swap it onto stdout for capture.
tui() { whiptail --title "couchbox installer" "$@" 3>&1 1>&2 2>&3; }

# The disk the installer booted from, if any, so it is never offered.
installer_disk() {
  local live
  live=$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null) || return 0
  lsblk -no PKNAME "$live" 2>/dev/null
}

# describe <disk>: "119.2G  Samsung SSD 970 (nvme)". One lsblk call per
# column, because MODEL and TRAN can each be empty or contain spaces.
describe() {
  local size model tran
  size=$(lsblk -dno SIZE "$1" | sed 's/^ *//; s/ *$//')
  model=$(lsblk -dno MODEL "$1" | sed 's/^ *//; s/ *$//')
  tran=$(lsblk -dno TRAN "$1" | sed 's/^ *//; s/ *$//')
  printf '%s  %s%s' "$size" "${model:-unknown model}" "${tran:+ ($tran)}"
}

pick_disk() {
  local skip name items=()
  skip=$(installer_disk)
  while read -r name; do
    [[ ${name#/dev/} == "$skip" ]] && continue
    items+=("$name" "$(describe "$name")")
  # Real disks only: zram swap also reports TYPE=disk, and empty card-reader
  # slots report size 0.
  done < <(lsblk -dnpo NAME,TYPE,SIZE -b | awk '$2 == "disk" && $3 > 0 && $1 !~ /\/zram/ { print $1 }')
  [[ ${#items[@]} -gt 0 ]] || die "no disks found to install on"
  tui --menu "Install couchbox on which disk?\n\nThe disk you pick is ERASED completely." \
    18 72 8 "${items[@]}"
}

while [[ $# -gt 0 ]]; do
  case $1 in
    --yes) assume_yes=1 ;;
    --hostname) hostname=${2:?}; shift ;;
    --timezone) timezone=${2:?}; shift ;;
    -h|--help) usage ;;
    -*) usage 1 ;;
    *) [[ -z ${disk:-} ]] || usage 1; disk=$1 ;;
  esac
  shift
done

# No disk on the command line: interactive install through menus.
interactive=0
if [[ -z ${disk:-} ]]; then
  [[ $assume_yes -eq 0 ]] || usage 1
  interactive=1
fi

[[ $EUID -eq 0 ]] || die "run as root"
[[ $(uname -m) == x86_64 ]] || die "only x86_64 is supported so far"
[[ -d /sys/firmware/efi ]] || die "boot the installer in UEFI mode"
[[ -e /usr/share/zoneinfo/$timezone ]] || die "unknown timezone: $timezone"

if [[ $interactive -eq 1 ]]; then
  disk=$(pick_disk) || die "cancelled; run couchbox-install to start again"
fi

[[ -b $disk && $(lsblk -dno TYPE "$disk") == disk ]] || die "$disk is not a whole disk"
[[ $(installer_disk) != "${disk#/dev/}" ]] || die "$disk holds the installer"
lsblk -o NAME,SIZE,MODEL,FSTYPE,MOUNTPOINTS "$disk"

# Always confirm unless --yes, whether the disk came from the menu or the
# command line. The default answer is No.
if [[ $assume_yes -eq 0 ]]; then
  tui --defaultno --yesno "Erase ALL data on $disk?\n\n$(describe "$disk")\n\nThis cannot be undone." 12 64 ||
    die "cancelled; nothing was changed"
fi

# packages <set>: one set from target-packages (that file says why each is there).
packages() { sed -n "s/^$1: *//p" "$target_list"; }
case $(grep -m1 -Po '^vendor_id\s*:\s*\K\S+' /proc/cpuinfo) in
  GenuineIntel) vendor=intel ;;
  AuthenticAMD) vendor=amd ;;
  *) vendor= ;;
esac
# shellcheck disable=SC2207  # package names contain no spaces
pkgs=($(packages all) $([[ -z $vendor ]] || packages "$vendor"))
[[ ${#pkgs[@]} -gt 0 ]] || die "no packages listed in $target_list"

echo "==> Partitioning $disk"
wipefs -a "$disk"
sfdisk --wipe always "$disk" <<'EOF'
label: gpt
size=1GiB, type=uefi, name=COUCHBOX_ESP
type=linux, name=COUCHBOX_ROOT
EOF
partprobe "$disk" 2>/dev/null || true
udevadm settle
# Use the kernel's partition nodes, not /dev/disk/by-partlabel links, which
# udev may not have updated yet on real hardware.
mapfile -t parts < <(lsblk -lnpo NAME,TYPE "$disk" | awk '$2 == "part" { print $1 }')
[[ ${#parts[@]} -eq 2 ]] || die "expected 2 partitions on $disk, found ${#parts[@]}"
esp=${parts[0]} rootdev=${parts[1]}

# A new partition can start where an old filesystem did. Clear leftover
# signatures so blkid doesn't see two filesystems on one partition.
wipefs -a "$esp" "$rootdev"
mkfs.fat -F 32 -n ESP "$esp"
mkfs.ext4 -F -L couchbox "$rootdev"
udevadm settle
[[ $(blkid -p -s TYPE -o value "$rootdev") == ext4 ]] || die "no ext4 found on $rootdev after mkfs; see wipefs $rootdev"

mount -t ext4 "$rootdev" /mnt
mount --mkdir -t vfat -o fmask=0077,dmask=0077 "$esp" /mnt/boot
trap 'umount -R /mnt 2>/dev/null || true' EXIT

echo "==> Installing packages"
# Written before pacstrap so the first mkinitcpio run finds it.
mkdir -p /mnt/etc
echo KEYMAP=us > /mnt/etc/vconsole.conf
conf=$(mktemp)
cat > "$conf" <<EOF
[options]
Architecture = auto
SigLevel = Required DatabaseOptional

[couchbox-offline]
SigLevel = Optional TrustAll
Server = file://$offline_dir
EOF
# -M: don't copy the live mirrorlist; the target gets its own below.
pacstrap -C "$conf" -K -M /mnt "${pkgs[@]}"
genfstab -U /mnt >> /mnt/etc/fstab

# For online updates later: Arch's geo-balanced mirror (the packaged
# mirrorlist has every server commented out), plus the couchbox repo: the
# assets of the latest couchbox release on GitHub, signed with the key in
# couchbox-keyring (installed above, so pacstrap -K already trusts it).
sed -i '0,/^#Server/s|^#Server|Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch\n&|' \
  /mnt/etc/pacman.d/mirrorlist
cat >> /mnt/etc/pacman.conf <<EOF

[couchbox]
SigLevel = Required
Server = $couchbox_repo_url
EOF

echo "==> Configuring system"
root_partuuid=$(blkid -s PARTUUID -o value "$rootdev")
arch-chroot /mnt /bin/bash -euo pipefail -s -- "$hostname" "$timezone" "$user" "$root_partuuid" <<'EOF'
hostname=$1 timezone=$2 user=$3 root_partuuid=$4

ln -sf "/usr/share/zoneinfo/$timezone" /etc/localtime
hwclock --systohc
sed -i 's/^#en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
locale-gen
echo LANG=en_US.UTF-8 > /etc/locale.conf
echo "$hostname" > /etc/hostname

# input: CEC and remotes via the Bigscreen input handler. uucp: USB CEC adapters.
useradd -m -G wheel,input,uucp -s /bin/bash "$user"
passwd -l "$user"
passwd -l root
echo '%wheel ALL=(ALL:ALL) ALL' > /etc/sudoers.d/10-wheel
chmod 440 /etc/sudoers.d/10-wheel

bootctl install
cat > /boot/loader/loader.conf <<LOADER
default couchbox.conf
timeout 0
editor no
LOADER
cat > /boot/loader/entries/couchbox.conf <<ENTRY
title   couchbox
linux   /vmlinuz-linux
initrd  /initramfs-linux.img
options root=PARTUUID=$root_partuuid rw quiet splash
ENTRY

# Apply only couchbox's preset. `preset-all` would also turn on systemd's own
# defaults (networkd-wait-online, resolved, homed), which fight NetworkManager.
systemctl preset $(awk '$1 == "enable" { print $2 }' /usr/lib/systemd/system-preset/80-couchbox.preset)

# Packages installed after couchbox-base in the pacstrap transaction may have
# added apps, so regenerate the home-screen blacklist once everything is in.
couchbox-update-app-blacklist
EOF

# set_password: ask twice; an empty password keeps the account locked.
# The password goes to chpasswd on stdin, never on a command line.
set_password() {
  local pw1 pw2 text="Password for the '$user' user, for sudo and SSH.\n\nroot stays locked; on a console (Ctrl+Alt+F2) log in as '$user'.\nLeave empty to keep '$user' locked (autologin still works)."
  while true; do
    pw1=$(tui --passwordbox "$text" 14 70) || return 0
    [[ -n $pw1 ]] || return 0
    pw2=$(tui --passwordbox "Type the password again." 8 70) || return 0
    if [[ $pw1 == "$pw2" ]]; then
      printf '%s:%s\n' "$user" "$pw1" | arch-chroot /mnt chpasswd
      return 0
    fi
    text="The passwords did not match. Try again.\n\nLeave empty to keep '$user' locked."
  done
}

if [[ $assume_yes -eq 0 ]]; then
  set_password
else
  echo "==> No password set (--yes); $user stays locked. Autologin still works."
fi

if [[ $interactive -eq 1 ]]; then
  umount -R /mnt
  if tui --yesno "couchbox is installed on $disk.\n\nRemove the USB stick, then choose Yes to reboot." 10 64; then
    systemctl reboot
  fi
else
  echo "==> Done. Remove the installer medium and reboot."
fi
