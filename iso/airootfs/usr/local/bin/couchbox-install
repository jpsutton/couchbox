#!/usr/bin/env bash
# Install couchbox onto a whole disk. ERASES the target disk.
#
#   couchbox-install                          menus: pick the disk, set a password
#   couchbox-install [--yes] [--hostname NAME] [--timezone ZONE] DISK
#
# Layout: GPT, 1 GiB ESP at /boot (systemd-boot), ext4 root on the rest.
# The full ISO installs from its offline repo, so no network is needed. The
# netinstall ISO has no offline repo: it downloads from Arch's mirrors and the
# couchbox repo on GitHub, and offers a Wi-Fi picker when there's no network.
set -euo pipefail

hostname=couchbox
timezone=UTC
user=htpc
assume_yes=0
couchbox_repo_url=https://github.com/jpsutton/couchbox/releases/latest/download
# Arch's geo-balanced mirror; $repo and $arch are pacman's, not the shell's.
# shellcheck disable=SC2016
arch_mirror='https://geo.mirror.pkgbuild.com/$repo/os/$arch'
offline_dir=/var/lib/couchbox/offline  # full ISO: everything the install needs
target_list=/etc/couchbox/target-packages
# Set by wifi_connect, so the installed system joins the same network.
wifi_ssid='' wifi_psk=''

usage() { sed -n '2,7s/^# \{0,1\}//p' "$0"; exit "${1:-0}"; }
die() { echo "couchbox-install: $*" >&2; exit 1; }

# whiptail writes the choice to stderr; swap it onto stdout for capture.
tui() { whiptail --title "couchbox installer" "$@" 3>&1 1>&2 2>&3; }

# The disk(s) the installer booted from, so they are never offered. Found by
# the ISO's UUID on the kernel command line, not by its mount: archiso copies a
# small image to RAM and unmounts the medium. A hybrid ISO shows the UUID on
# the whole disk and on its first partition.
installer_disks() {
  local uuid dev parent
  uuid=$(sed -n 's/.*archisosearchuuid=\([^ ]*\).*/\1/p' /proc/cmdline)
  [[ -n $uuid ]] || return 0
  blkid -t UUID="$uuid" -o device 2>/dev/null | while read -r dev; do
    parent=$(lsblk -dno PKNAME "$dev" 2>/dev/null)
    basename "${parent:-$dev}"
  done | sort -u
}
is_installer_disk() { installer_disks | grep -qxF "${1#/dev/}"; }

# describe <disk>: "119.2G  Samsung SSD 970 (nvme)". One lsblk call per
# column, because MODEL and TRAN can each be empty or contain spaces.
describe() {
  local size model tran
  size=$(lsblk -dno SIZE "$1" | sed 's/^ *//; s/ *$//')
  model=$(lsblk -dno MODEL "$1" | sed 's/^ *//; s/ *$//')
  tran=$(lsblk -dno TRAN "$1" | sed 's/^ *//; s/ *$//')
  printf '%s  %s%s' "$size" "${model:-unknown model}" "${tran:+ ($tran)}"
}

pick_disk() {
  local name items=()
  while read -r name; do
    is_installer_disk "$name" && continue
    items+=("$name" "$(describe "$name")")
  # Real disks only: zram swap and floppy drives (VMs) also report TYPE=disk,
  # and empty card-reader slots report size 0.
  done < <(lsblk -dnpo NAME,TYPE,SIZE -b | awk '$2 == "disk" && $3 > 0 && $1 !~ /\/(zram|fd)[0-9]/ { print $1 }')
  [[ ${#items[@]} -gt 0 ]] || die "no disks found to install on"
  tui --menu "Install couchbox on which disk?\n\nThe disk you pick is ERASED completely." \
    18 72 8 "${items[@]}"
}

# online: the couchbox repo on GitHub answers (it redirects to the release).
online() { curl -sfIL --max-time 10 -o /dev/null "$couchbox_repo_url/couchbox.db"; }

# The first Wi-Fi interface, if any.
wifi_device() {
  local dev
  for dev in /sys/class/net/*; do
    [[ -e $dev/phy80211 ]] && { basename "$dev"; return 0; }
  done
  return 0
}

# iwd's file name for a network's settings: the SSID itself when it is only
# letters, digits, space, _ and -, else = and the SSID in hex.
iwd_name() {
  if [[ $1 =~ ^[A-Za-z0-9\ _-]+$ ]]; then
    printf '%s' "$1"
  else
    printf '=%s' "$(printf '%s' "$1" | od -An -tx1 | tr -d ' \n')"
  fi
}

# wifi_connect: scan, pick a network, ask for its passphrase, connect.
# Returns 0 once the couchbox repo is reachable.
wifi_connect() {
  local dev line ssid sec pw i choice items=() ssids=() secs=()
  dev=$(wifi_device)
  [[ -n $dev ]] || return 1
  echo "==> Scanning for Wi-Fi networks on $dev"
  iwctl station "$dev" scan 2>/dev/null || true
  sleep 5
  # get-networks prints a table, colored even when piped: strip the escapes,
  # then take the rows that end in security and a signal bar of *s.
  while IFS= read -r line; do
    line=$(sed 's/\x1b\[[0-9;]*m//g; s/^[ >]*//; s/ *$//' <<<"$line")
    if [[ $line =~ ^(.*[^ ])\ +(open|psk|8021x|wep)\ +\*+$ ]]; then
      ssids+=("${BASH_REMATCH[1]}")
      secs+=("${BASH_REMATCH[2]}")
    fi
  done < <(iwctl station "$dev" get-networks 2>/dev/null)
  if [[ ${#ssids[@]} -eq 0 ]]; then
    tui --msgbox "No Wi-Fi networks found on $dev." 8 60
    return 1
  fi
  for i in "${!ssids[@]}"; do
    items+=("$((i + 1))" "${ssids[i]}  (${secs[i]})")
  done
  choice=$(tui --menu "Connect to which Wi-Fi network?" 18 70 10 "${items[@]}") || return 1
  ssid=${ssids[choice - 1]} sec=${secs[choice - 1]}
  case $sec in
    open) pw= ;;
    psk)
      pw=$(tui --passwordbox "Passphrase for '$ssid'" 8 70) || return 1
      # In a settings file, not on iwctl's command line.
      mkdir -p /var/lib/iwd
      printf '[Security]\nPassphrase=%s\n' "$pw" > "/var/lib/iwd/$(iwd_name "$ssid").psk"
      chmod 600 "/var/lib/iwd/$(iwd_name "$ssid").psk"
      ;;
    *)
      tui --msgbox "'$ssid' uses $sec security, which this menu can't set up.\n\nQuit to the shell and use iwctl." 10 64
      return 1 ;;
  esac
  echo "==> Connecting to $ssid"
  iwctl --dont-ask station "$dev" connect "$ssid" || true
  for i in $(seq 15); do
    if online; then
      wifi_ssid=$ssid wifi_psk=$pw
      return 0
    fi
    sleep 2
  done
  tui --msgbox "Could not reach the internet through '$ssid'.\n\nCheck the passphrase and try again." 10 64
  return 1
}

# ensure_network: wait for a working connection. Wired comes up by itself
# (DHCP); in the menus, offer Wi-Fi and retries.
ensure_network() {
  local i choice items
  echo "==> Checking the network"
  for i in $(seq "$1"); do
    online && return 0
    sleep 5
  done
  [[ $interactive -eq 1 ]] || die "no network: cannot reach $couchbox_repo_url"
  while ! online; do
    items=(retry "Try again (after plugging in a network cable)")
    [[ -z $(wifi_device) ]] || items+=(wifi "Connect to Wi-Fi")
    items+=(quit "Quit to a shell")
    choice=$(tui --menu "No internet connection.\n\nThis installer downloads couchbox (about 1.5 GiB)." 15 70 3 "${items[@]}") || choice=quit
    case $choice in
      wifi) wifi_connect && return 0 ;;
      quit) die "no network; connect (iwctl for Wi-Fi), then run couchbox-install" ;;
    esac
  done
}

while [[ $# -gt 0 ]]; do
  case $1 in
    --yes) assume_yes=1 ;;
    --hostname) hostname=${2:?}; shift ;;
    --timezone) timezone=${2:?}; shift ;;
    -h|--help) usage ;;
    -*) usage 1 ;;
    *) [[ -z ${disk:-} ]] || usage 1; disk=$1 ;;
  esac
  shift
done

# No disk on the command line: interactive install through menus.
interactive=0
if [[ -z ${disk:-} ]]; then
  [[ $assume_yes -eq 0 ]] || usage 1
  interactive=1
fi

[[ $EUID -eq 0 ]] || die "run as root"
[[ $(uname -m) == x86_64 ]] || die "only x86_64 is supported so far"
[[ -d /sys/firmware/efi ]] || die "boot the installer in UEFI mode"
[[ -e /usr/share/zoneinfo/$timezone ]] || die "unknown timezone: $timezone"

# The netinstall ISO has no offline repo, so check the network before
# touching a disk.
if [[ -d $offline_dir ]]; then
  netinstall=0
else
  netinstall=1
  # Unattended: wait up to a minute for wired DHCP.
  if [[ $interactive -eq 1 ]]; then ensure_network 2; else ensure_network 12; fi
fi

if [[ $interactive -eq 1 ]]; then
  disk=$(pick_disk) || die "cancelled; run couchbox-install to start again"
fi

[[ -b $disk && $(lsblk -dno TYPE "$disk") == disk ]] || die "$disk is not a whole disk"
! is_installer_disk "$disk" || die "$disk holds the installer"
lsblk -o NAME,SIZE,MODEL,FSTYPE,MOUNTPOINTS "$disk"

# Always confirm unless --yes, whether the disk came from the menu or the
# command line. The default answer is No.
if [[ $assume_yes -eq 0 ]]; then
  tui --defaultno --yesno "Erase ALL data on $disk?\n\n$(describe "$disk")\n\nThis cannot be undone." 12 64 ||
    die "cancelled; nothing was changed"
fi

# packages <set>: one set from target-packages (that file says why each is there).
packages() { sed -n "s/^$1: *//p" "$target_list"; }
case $(grep -m1 -Po '^vendor_id\s*:\s*\K\S+' /proc/cpuinfo) in
  GenuineIntel) vendor=intel ;;
  AuthenticAMD) vendor=amd ;;
  *) vendor= ;;
esac
# shellcheck disable=SC2207  # package names contain no spaces
pkgs=($(packages all) $([[ -z $vendor ]] || packages "$vendor"))
[[ ${#pkgs[@]} -gt 0 ]] || die "no packages listed in $target_list"

# Signature checks need the live keyring (with couchbox's key). Once the
# network is up, pacman-init.service waits for the clock to sync, then sets the
# keyring up; that usually finishes while the disk menu is open.
if [[ $netinstall -eq 1 ]]; then
  echo "==> Preparing the package keyring (waits for the clock to sync)"
  timeout 120 systemctl start pacman-init.service || die "the pacman keyring is not ready (pacman-init.service); nothing was changed"
fi

echo "==> Partitioning $disk"
wipefs -a "$disk"
sfdisk --wipe always "$disk" <<'EOF'
label: gpt
size=1GiB, type=uefi, name=COUCHBOX_ESP
type=linux, name=COUCHBOX_ROOT
EOF
partprobe "$disk" 2>/dev/null || true
udevadm settle
# Use the kernel's partition nodes, not /dev/disk/by-partlabel links, which
# udev may not have updated yet on real hardware.
mapfile -t parts < <(lsblk -lnpo NAME,TYPE "$disk" | awk '$2 == "part" { print $1 }')
[[ ${#parts[@]} -eq 2 ]] || die "expected 2 partitions on $disk, found ${#parts[@]}"
esp=${parts[0]} rootdev=${parts[1]}

# A new partition can start where an old filesystem did. Clear leftover
# signatures so blkid doesn't see two filesystems on one partition.
wipefs -a "$esp" "$rootdev"
mkfs.fat -F 32 -n ESP "$esp"
mkfs.ext4 -F -L couchbox "$rootdev"
udevadm settle
[[ $(blkid -p -s TYPE -o value "$rootdev") == ext4 ]] || die "no ext4 found on $rootdev after mkfs; see wipefs $rootdev"

mount -t ext4 "$rootdev" /mnt
mount --mkdir -t vfat -o fmask=0077,dmask=0077 "$esp" /mnt/boot
trap 'umount -R /mnt 2>/dev/null || true' EXIT

echo "==> Installing packages"
# Written before pacstrap so the first mkinitcpio run finds it.
mkdir -p /mnt/etc
echo KEYMAP=us > /mnt/etc/vconsole.conf
conf=$(mktemp)
if [[ $netinstall -eq 0 ]]; then
  cat > "$conf" <<EOF
[options]
Architecture = auto
SigLevel = Required DatabaseOptional

[couchbox-offline]
SigLevel = Optional TrustAll
Server = file://$offline_dir
EOF
else
  # Arch first, then couchbox, the same order the installed system uses.
  cat > "$conf" <<EOF
[options]
Architecture = auto
ParallelDownloads = 5
SigLevel = Required DatabaseOptional

[core]
Server = $arch_mirror

[extra]
Server = $arch_mirror

[couchbox]
SigLevel = Required
Server = $couchbox_repo_url
EOF
fi
# -M: don't copy the live mirrorlist; the target gets its own below.
pacstrap -C "$conf" -K -M /mnt "${pkgs[@]}"
genfstab -U /mnt >> /mnt/etc/fstab

# For online updates later: Arch's geo-balanced mirror (the packaged
# mirrorlist has every server commented out), plus the couchbox repo: the
# assets of the latest couchbox release on GitHub, signed with the key in
# couchbox-keyring (installed above, so pacstrap -K already trusts it).
sed -i "0,/^#Server/s|^#Server|Server = $arch_mirror\n&|" \
  /mnt/etc/pacman.d/mirrorlist
cat >> /mnt/etc/pacman.conf <<EOF

[couchbox]
SigLevel = Required
Server = $couchbox_repo_url
EOF

# A Wi-Fi network joined from the installer: give NetworkManager on the
# installed system the same one, so the box is online after the first boot.
if [[ -n $wifi_ssid ]]; then
  nmconn=/mnt/etc/NetworkManager/system-connections/couchbox-install-wifi.nmconnection
  mkdir -p "${nmconn%/*}"
  {
    printf '[connection]\nid=%s\ntype=wifi\n\n[wifi]\nmode=infrastructure\nssid=%s\n\n' "$wifi_ssid" "$wifi_ssid"
    [[ -z $wifi_psk ]] || printf '[wifi-security]\nkey-mgmt=wpa-psk\npsk=%s\n\n' "$wifi_psk"
    printf '[ipv4]\nmethod=auto\n\n[ipv6]\nmethod=auto\n'
  } > "$nmconn"
  chmod 600 "$nmconn"
fi

echo "==> Configuring system"
root_partuuid=$(blkid -s PARTUUID -o value "$rootdev")
arch-chroot /mnt /bin/bash -euo pipefail -s -- "$hostname" "$timezone" "$user" "$root_partuuid" <<'EOF'
hostname=$1 timezone=$2 user=$3 root_partuuid=$4

ln -sf "/usr/share/zoneinfo/$timezone" /etc/localtime
hwclock --systohc
sed -i 's/^#en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
locale-gen
echo LANG=en_US.UTF-8 > /etc/locale.conf
echo "$hostname" > /etc/hostname

# input: CEC and remotes via the Bigscreen input handler. uucp: USB CEC adapters.
useradd -m -G wheel,input,uucp -s /bin/bash "$user"
passwd -l "$user"
passwd -l root
echo '%wheel ALL=(ALL:ALL) ALL' > /etc/sudoers.d/10-wheel
chmod 440 /etc/sudoers.d/10-wheel

bootctl install
cat > /boot/loader/loader.conf <<LOADER
default couchbox.conf
timeout 0
editor no
LOADER
cat > /boot/loader/entries/couchbox.conf <<ENTRY
title   couchbox
linux   /vmlinuz-linux
initrd  /initramfs-linux.img
options root=PARTUUID=$root_partuuid rw quiet splash
ENTRY

# Apply only couchbox's preset. `preset-all` would also turn on systemd's own
# defaults (networkd-wait-online, resolved, homed), which fight NetworkManager.
systemctl preset $(awk '$1 == "enable" { print $2 }' /usr/lib/systemd/system-preset/80-couchbox.preset)

# Packages installed after couchbox-base in the pacstrap transaction may have
# added apps, so regenerate the home-screen blacklist once everything is in.
couchbox-update-app-blacklist
EOF

# set_password: ask twice; an empty password keeps the account locked.
# The password goes to chpasswd on stdin, never on a command line.
set_password() {
  local pw1 pw2 text="Password for the '$user' user, for sudo and SSH.\n\nroot stays locked; on a console (Ctrl+Alt+F2) log in as '$user'.\nLeave empty to keep '$user' locked (autologin still works)."
  while true; do
    pw1=$(tui --passwordbox "$text" 14 70) || return 0
    [[ -n $pw1 ]] || return 0
    pw2=$(tui --passwordbox "Type the password again." 8 70) || return 0
    if [[ $pw1 == "$pw2" ]]; then
      printf '%s:%s\n' "$user" "$pw1" | arch-chroot /mnt chpasswd
      return 0
    fi
    text="The passwords did not match. Try again.\n\nLeave empty to keep '$user' locked."
  done
}

if [[ $assume_yes -eq 0 ]]; then
  set_password
else
  echo "==> No password set (--yes); $user stays locked. Autologin still works."
fi

if [[ $interactive -eq 1 ]]; then
  umount -R /mnt
  if tui --yesno "couchbox is installed on $disk.\n\nRemove the USB stick, then choose Yes to reboot." 10 64; then
    systemctl reboot
  fi
else
  echo "==> Done. Remove the installer medium and reboot."
fi
