#!/usr/bin/env python3
"""Use the power-saver profile while the screen sleeps.

PowerDevil blanks the HDMI output (DPMS off) after the idle timeout, and the
TV goes to sleep on "no signal". This switches power-profiles-daemon to
power-saver while every connected output is off, and back to the profile
that was active before (normally balanced) when one comes back on.

DPMS changes send no uevent, so the connectors' sysfs state is polled.
"""
import glob
import os
import subprocess
import sys
import time

INTERVAL = float(os.environ.get("COUCHBOX_POWER_POLL", "5"))
SLEEP_PROFILE = "power-saver"


def screen_on():
    """True while any connected output is lit. No connected output (a TV
    that drops hotplug when off) counts as asleep."""
    for status in glob.glob("/sys/class/drm/card*-*/status"):
        connector = os.path.dirname(status)
        try:
            with open(status) as f:
                if f.read().strip() != "connected":
                    continue
            with open(os.path.join(connector, "dpms")) as f:
                if f.read().strip() == "On":
                    return True
        except OSError:
            continue
    return False


def profile(new=None):
    args = ["powerprofilesctl", "set", new] if new else ["powerprofilesctl", "get"]
    result = subprocess.run(args, capture_output=True, text=True)
    if result.returncode != 0:
        print(f"{' '.join(args)}: {result.stderr.strip()}", file=sys.stderr, flush=True)
        return None
    return result.stdout.strip()


def main():
    saved = None  # the profile to return to; set while the screen sleeps
    was_on = True
    while True:
        on = screen_on()
        if on != was_on:
            if not on:
                current = profile()
                if current and current != SLEEP_PROFILE:
                    saved = current
                    if profile(SLEEP_PROFILE) is not None:
                        print(f"screen off: {current} -> {SLEEP_PROFILE}", flush=True)
            elif saved:
                # Only undo our own switch: leave a profile someone picked
                # while the screen was off.
                if profile() == SLEEP_PROFILE and profile(saved) is not None:
                    print(f"screen on: {SLEEP_PROFILE} -> {saved}", flush=True)
                saved = None
            was_on = on
        time.sleep(INTERVAL)


if __name__ == "__main__":
    main()
