#!/usr/bin/env python3
"""Use the power-saver profile while the screen sleeps.

PowerDevil blanks the HDMI output (DPMS off) after the idle timeout, and the
TV goes to sleep on "no signal". This switches power-profiles-daemon to
power-saver while every connected output is off, and back to the profile
that was active before (normally balanced) when one comes back on.

On Bay Trail and Cherry Trail GPUs it also raises the GPU's clock floor
while the screen is on (see gpu_floor).

DPMS changes send no uevent, so the connectors' sysfs state is polled.
"""
import glob
import os
import subprocess
import sys
import time

INTERVAL = float(os.environ.get("COUCHBOX_POWER_POLL", "5"))
SLEEP_PROFILE = "power-saver"


def screen_on():
    """True while any connected output is lit. No connected output (a TV
    that drops hotplug when off) counts as asleep."""
    for status in glob.glob("/sys/class/drm/card*-*/status"):
        connector = os.path.dirname(status)
        try:
            with open(status) as f:
                if f.read().strip() != "connected":
                    continue
            with open(os.path.join(connector, "dpms")) as f:
                if f.read().strip() == "On":
                    return True
        except OSError:
            continue
    return False


def gpu_floor(on):
    """Bay Trail and Cherry Trail (the GPUs with gt_vlv_rpe_freq_mhz): with
    the clock floor at the hardware minimum (RPn, 187 MHz on an N2807), the
    governor never raises the clock for compositing video. Each frame is a
    short burst, so the GPU looks mostly idle, but at 187 MHz the burst
    often misses the refresh deadline: KWin got about 52 of 60 refreshes a
    second. With the floor at RP1 (312 MHz there) the governor ramps up and
    down as it should and all 60 make it; a 646 MHz floor did no better.
    It is a floor, not a fixed clock, and an idle GPU still powers down
    (RC6). While the screen sleeps the floor goes back to RPn. Checked on
    every poll, as i915 may come up after this service."""
    for marker in glob.glob("/sys/class/drm/card*/gt_vlv_rpe_freq_mhz"):
        card = os.path.dirname(marker)
        try:
            with open(os.path.join(card, "gt_RP1_freq_mhz")) as f:
                rp1 = f.read().strip()
            with open(os.path.join(card, "gt_RPn_freq_mhz")) as f:
                rpn = f.read().strip()
            want = rp1 if on else rpn
            min_path = os.path.join(card, "gt_min_freq_mhz")
            with open(min_path) as f:
                if f.read().strip() == want:
                    continue
            with open(min_path, "w") as f:
                f.write(want)
            print(f"{os.path.basename(card)}: GPU clock floor {want} MHz", flush=True)
        except OSError as e:
            print(f"{card}: could not set the GPU clock floor: {e}", file=sys.stderr, flush=True)


def profile(new=None):
    args = ["powerprofilesctl", "set", new] if new else ["powerprofilesctl", "get"]
    result = subprocess.run(args, capture_output=True, text=True)
    if result.returncode != 0:
        print(f"{' '.join(args)}: {result.stderr.strip()}", file=sys.stderr, flush=True)
        return None
    return result.stdout.strip()


def main():
    saved = None  # the profile to return to; set while the screen sleeps
    was_on = True
    while True:
        on = screen_on()
        gpu_floor(on)
        if on != was_on:
            if not on:
                current = profile()
                if current and current != SLEEP_PROFILE:
                    saved = current
                    if profile(SLEEP_PROFILE) is not None:
                        print(f"screen off: {current} -> {SLEEP_PROFILE}", flush=True)
            elif saved:
                # Only undo our own switch: leave a profile someone picked
                # while the screen was off.
                if profile() == SLEEP_PROFILE and profile(saved) is not None:
                    print(f"screen on: {SLEEP_PROFILE} -> {saved}", flush=True)
                saved = None
            was_on = on
        time.sleep(INTERVAL)


if __name__ == "__main__":
    main()
