#!/usr/bin/env bash
# Hide every installed app from the Bigscreen home screen except the ones in
# /etc/couchbox/visible-apps. Bigscreen only supports a blacklist, so build
# one from everything in /usr/share/applications that isn't allowed.
# Runs from a pacman hook whenever .desktop files change.
set -euo pipefail

allow=/etc/couchbox/visible-apps
out=/etc/xdg/applications-blacklistrc

declare -A visible=()
while read -r name; do
  [[ -z $name || $name == \#* ]] || visible[$name]=1
done < "$allow"

hidden=()
for f in /usr/share/applications/*.desktop; do
  name=${f##*/}
  name=${name%.desktop}
  [[ -n ${visible[$name]:-} ]] || hidden+=("${name//,/\\,}")
done

tmp=$(mktemp "$out.XXXXXX")
{
  echo "# Generated by couchbox-update-app-blacklist from $allow. Do not edit."
  echo "[Applications]"
  # [$i] (KDE Kiosk) locks the key. Bigscreen's envmanager rewrites its own
  # ~/.config/plasma-bigscreen/applications-blacklistrc at every login, and
  # that file would otherwise win over this one.
  (IFS=,; echo "blacklist[\$i]=${hidden[*]}")
} > "$tmp"
chmod 644 "$tmp"
mv "$tmp" "$out"
