# pacman loads hooks at the start of a transaction, so the blacklist hook
# doesn't fire in the transaction that installs it. Run the update here too.
post_install() {
  couchbox-update-app-blacklist
}

post_upgrade() {
  couchbox-update-app-blacklist
  # Up to 0.8.1, couchbox-power-profile.service was installed into
  # multi-user.target, which made an ordering cycle; move it to graphical.target.
  if [[ -L etc/systemd/system/multi-user.target.wants/couchbox-power-profile.service ]]; then
    systemctl reenable couchbox-power-profile.service
  fi
}
