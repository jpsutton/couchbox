# System-wide shortcut defaults, read by kglobalaccel for users who have no
# saved assignment yet. Format: active,default,description.
#
# A short Home or Menu press belongs to the app in front (Kodi's home screen
# and context menu, Plezy's Home tab); a long press is the system action,
# sent by fire-blaster ([hold], /etc/fire-blaster/config.toml) as a Meta chord:
#   long Home = Meta+Home Page -> couchbox-home KWin script (home screen)
#   long Menu = Meta+O         -> Bigscreen's home overlay (its default), whose
#                                 Tasks page lists open apps (hold OK to close one)
# So Bigscreen's own plain Home Page and Menu bindings, which would take those
# keys from every app, are moved off them. (The tasks overview shortcut
# is dead in Bigscreen 6.7.5 anyway: nothing handles it.)
[plasmashell]
Toggle Bigscreen Home Screen=none,Home Page,Toggle Bigscreen Home Screen
Toggle Bigscreen Tasks Overview=none,Menu,Toggle Bigscreen Tasks Overview

# Plasma's Media Controller takes the media keys from every app and forwards
# them over MPRIS, so apps without MPRIS (Kodi) never get them. Unbound, the
# keys go to the app in front: Kodi and Plezy (patched to toggle on Play/Pause,
# see plezy-couchbox) handle them themselves.
[mediacontrol]
nextmedia=none,Media Next,Media playback next
pausemedia=none,Media Pause,Pause media playback
playpausemedia=none,Media Play,Play/Pause media playback
previousmedia=none,Media Previous,Media playback previous
seekbackwardmedia=none,Media Rewind,Media playback seek backward 5s
seekforwardmedia=none,Media Fast Forward,Media playback seek forward 5s
