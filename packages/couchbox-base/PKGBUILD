# Maintainer: Jared Sutton <jpsutton@protonmail.com>
#
# Meta package for the couchbox appliance. It pulls in the Bigscreen session
# and the apps (Kodi, Plezy, YouTube), and ships the config that turns a plain
# Arch install into the appliance: autologin, service presets, and home-screen
# tiles.

pkgname=couchbox-base
pkgver=0.10.1
pkgrel=1
pkgdesc="couchbox HTPC OS: Plasma Bigscreen autologin session with app tiles (Kodi, Plezy, YouTube)"
arch=(any)
license=(MIT)
depends=(
  # Session
  plasma-bigscreen plasma-nm plasma-pa kscreen powerdevil xdg-desktop-portal-kde sddm
  # Hardware and networking
  networkmanager bluez bluez-utils libcec pipewire pipewire-pulse wireplumber
  # Power-saver profile while the screen sleeps (couchbox-power-profile)
  power-profiles-daemon
  # couchbox-video-profile: vainfo for what the GPU decodes
  # couchbox-timezone: curl for the GeoIP lookup, kconfig for couchboxrc
  curl kconfig
  python libva-utils
  zerotier-one
  # The remote: long-press Home (and IR once a blaster is fitted)
  fire-blaster
  # couchbox-bt-agent
  python-dbus python-gobject
  # Clients (the Kodi add-ons come from the AUR, see aur.txt)
  kodi kodi-addon-jellyfin kodi-addon-jellycon kodi-addon-couchbox-shuffle
  # Plezy with couchbox's patches (provides plezy; named so pacman picks it)
  plezy-couchbox
  # YouTube's TV interface (packages/couchbox-youtube)
  couchbox-youtube
  # Home-screen wallpapers for Bigscreen's default slideshow
  couchbox-wallpapers
  # The couchbox page in Bigscreen Settings (packages/couchbox-settings)
  couchbox-settings
  # Trusts the key that signs the [couchbox] repo
  couchbox-keyring
  # kodi-addon-jellyfin imports typing_extensions but doesn't depend on it
  python-typing_extensions
  noto-fonts
  # Debugging from the couch with a keyboard
  konsole
)
backup=(etc/sddm.conf.d/couchbox.conf etc/couchbox/visible-apps etc/fire-blaster/config.toml)
install=couchbox-base.install
# Client tiles. Each must keep the app's own desktop file ID (the window's app
# ID): Bigscreen raises a running app only when the tile's ID matches, and
# otherwise launches it again. Bigscreen sorts the Applications row by name.
_tiles=(com.edde746.plezy.desktop kodi.desktop)
source=(
  sddm-couchbox.conf
  kscreenlockerrc
  kwalletrc
  powerdevilrc
  plasmabigscreenrc
  80-couchbox.preset
  visible-apps
  couchbox-update-app-blacklist
  couchbox-app-blacklist.hook
  couchbox-bt-agent
  couchbox-bt-agent.service
  couchbox-power-profile
  couchbox-power-profile.service
  couchbox-video-profile
  couchbox-video-profile.service
  couchbox-timezone
  couchbox-timezone.service
  50-couchbox-timezone.rules
  90-couchbox-wifi-backup
  sysctl-couchbox-arp.conf
  kwinrc
  couchbox-home.json
  couchbox-home.js
  fire-blaster.toml
  kglobalshortcutsrc
  plezy-prefs.json
  kactivitymanagerd-pluginsrc
  60-couchbox-hdmi-passthrough.conf
  61-couchbox-hdmi-default.conf
  kodi-guisettings.xml
  couchbox-wallpaper-rotation.js
  "${_tiles[@]}"
)
sha256sums=(SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP)

package() {
  install -Dm644 sddm-couchbox.conf "$pkgdir/etc/sddm.conf.d/couchbox.conf"
  install -Dm644 kscreenlockerrc "$pkgdir/etc/xdg/kscreenlockerrc"
  install -Dm644 kwalletrc "$pkgdir/etc/xdg/kwalletrc"
  install -Dm644 powerdevilrc "$pkgdir/etc/xdg/powerdevilrc"
  install -Dm644 plasmabigscreenrc "$pkgdir/etc/xdg/plasmabigscreenrc"
  install -Dm644 80-couchbox.preset "$pkgdir/usr/lib/systemd/system-preset/80-couchbox.preset"
  install -Dm644 visible-apps "$pkgdir/etc/couchbox/visible-apps"
  install -Dm755 couchbox-update-app-blacklist "$pkgdir/usr/bin/couchbox-update-app-blacklist"
  install -Dm644 couchbox-app-blacklist.hook "$pkgdir/usr/share/libalpm/hooks/couchbox-app-blacklist.hook"
  install -Dm755 couchbox-bt-agent "$pkgdir/usr/bin/couchbox-bt-agent"
  install -Dm644 couchbox-bt-agent.service "$pkgdir/usr/lib/systemd/system/couchbox-bt-agent.service"
  install -Dm755 couchbox-power-profile "$pkgdir/usr/bin/couchbox-power-profile"
  install -Dm644 couchbox-power-profile.service "$pkgdir/usr/lib/systemd/system/couchbox-power-profile.service"
  # Video defaults for the hardware, picked once at the first login. Enabled for
  # every user by the shipped wants symlink.
  install -Dm755 couchbox-video-profile "$pkgdir/usr/bin/couchbox-video-profile"
  install -Dm644 couchbox-video-profile.service "$pkgdir/usr/lib/systemd/user/couchbox-video-profile.service"
  install -d "$pkgdir/usr/lib/systemd/user/default.target.wants"
  ln -s ../couchbox-video-profile.service "$pkgdir/usr/lib/systemd/user/default.target.wants/couchbox-video-profile.service"
  # Time zone from the network's location at every login, unless switched off.
  install -Dm755 couchbox-timezone "$pkgdir/usr/bin/couchbox-timezone"
  install -Dm644 couchbox-timezone.service "$pkgdir/usr/lib/systemd/user/couchbox-timezone.service"
  ln -s ../couchbox-timezone.service "$pkgdir/usr/lib/systemd/user/default.target.wants/couchbox-timezone.service"
  install -Dm644 50-couchbox-timezone.rules "$pkgdir/usr/share/polkit-1/rules.d/50-couchbox-timezone.rules"
  install -Dm755 90-couchbox-wifi-backup "$pkgdir/usr/lib/NetworkManager/dispatcher.d/90-couchbox-wifi-backup"
  install -Dm644 sysctl-couchbox-arp.conf "$pkgdir/usr/lib/sysctl.d/90-couchbox-arp.conf"
  install -Dm644 kwinrc "$pkgdir/etc/xdg/kwinrc"
  install -Dm644 fire-blaster.toml "$pkgdir/etc/fire-blaster/config.toml"
  install -Dm644 kglobalshortcutsrc "$pkgdir/etc/xdg/kglobalshortcutsrc"
  install -Dm644 kactivitymanagerd-pluginsrc "$pkgdir/etc/xdg/kactivitymanagerd-pluginsrc"
  install -Dm644 60-couchbox-hdmi-passthrough.conf "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/60-couchbox-hdmi-passthrough.conf"
  install -Dm644 61-couchbox-hdmi-default.conf "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/61-couchbox-hdmi-default.conf"
  # Plezy: TV layout and fullscreen from the first start. No client_identifier:
  # Plezy generates one per box on first run.
  install -Dm644 plezy-prefs.json "$pkgdir/etc/skel/.local/share/com.edde746.plezy/shared_preferences.json"
  install -Dm644 kodi-guisettings.xml "$pkgdir/etc/skel/.kodi/userdata/guisettings.xml"
  install -Dm644 couchbox-wallpaper-rotation.js "$pkgdir/usr/share/plasma/shells/org.kde.plasma.bigscreen/contents/updates/couchbox-wallpaper-rotation.js"

  # KWin script: the remote's Home key shows the home screen.
  install -Dm644 couchbox-home.json "$pkgdir/usr/share/kwin/scripts/couchbox-home/metadata.json"
  install -Dm644 couchbox-home.js "$pkgdir/usr/share/kwin/scripts/couchbox-home/contents/code/main.js"

  # The tiles override the apps' stock .desktop files per user (same file ID
  # in ~/.local/share/applications wins over /usr/share/applications), so the
  # Jellyfin tile can pass --fullscreen --tv.
  #
  # No Bigscreen favorites are shipped: the Favorites row only shows when it
  # has entries, and the allowlisted apps already fill the Applications row.
  local tile
  for tile in "${_tiles[@]}"; do
    install -Dm644 "$tile" "$pkgdir/etc/skel/.local/share/applications/$tile"
  done
}
