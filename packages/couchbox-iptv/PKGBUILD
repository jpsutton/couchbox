# Maintainer: Jared Sutton <jpsutton@protonmail.com>
#
# couchbox-iptv: free internet TV (the channels iptv-org lists) with a channel
# guide, for a TV remote, plus its background refresh job. Built from
# https://github.com/jpsutton/couchbox-iptv at a tag; bump pkgver to follow a
# new one.

pkgname=couchbox-iptv
pkgver=0.3.1
pkgrel=1
_flutter_ver=3.47.1
pkgdesc="Free internet TV with a channel guide, for couchbox"
arch=(x86_64 aarch64)
url="https://github.com/jpsutton/couchbox-iptv"
license=(GPL-3.0-only)
depends=(
  gtk3 glib2 glibc libgcc libstdc++ libepoxy libglvnd wayland hicolor-icon-theme
  # Video: the native mpv plane (libmpv); the channel database (system SQLite)
  mpv sqlite
  # The refresh job eases off while something plays (pactl)
  libpulse
)
makedepends=(clang cmake ninja git pkgconf)
# fvm fetches the pinned Flutter on x86_64; Arch Linux ARM has no fvm, so
# aarch64 builds Flutter's own checkout at the same tag (it downloads its
# arm64 engine on first run). Flutter can't cross-compile Linux desktop apps.
makedepends_x86_64=(fvm)
source=("$pkgname::git+https://github.com/jpsutton/couchbox-iptv.git#tag=v$pkgver")
source_aarch64=("flutter::git+https://github.com/flutter/flutter.git#tag=$_flutter_ver")
sha256sums=(SKIP)
sha256sums_aarch64=(SKIP)

# The pinned Flutter and Dart, whichever way they were fetched.
_flutter() {
  if [[ $CARCH == x86_64 ]]; then fvm flutter "$@"; else "$srcdir/flutter/bin/flutter" "$@"; fi
}
_dart() {
  if [[ $CARCH == x86_64 ]]; then fvm dart "$@"; else "$srcdir/flutter/bin/dart" "$@"; fi
}
# Flutter's name for the build's target, in build/linux/<arch>/.
_flutter_arch() {
  if [[ $CARCH == x86_64 ]]; then echo x64; else echo arm64; fi
}

prepare() {
  cd $pkgname
  export FVM_CACHE_PATH="$srcdir/fvm"
  if [[ $CARCH == x86_64 ]]; then
    fvm install $_flutter_ver
    fvm global $_flutter_ver
  fi
  _flutter --disable-analytics
}

build() {
  cd $pkgname
  export FVM_CACHE_PATH="$srcdir/fvm"
  _flutter build linux --release
  _dart build cli -o build/refresh
}

package() {
  cd $pkgname

  # The app: Flutter's bundle as is (it finds lib/ and data/ next to the
  # binary), started through /usr/bin.
  install -d "$pkgdir/usr/lib/$pkgname"
  cp -a "build/linux/$(_flutter_arch)/release/bundle/." "$pkgdir/usr/lib/$pkgname/"
  install -d "$pkgdir/usr/bin"
  ln -s "/usr/lib/$pkgname/$pkgname" "$pkgdir/usr/bin/$pkgname"

  # The refresh job (dart build cli; SQLite comes from the system).
  install -Dm755 build/refresh/bundle/bin/couchbox_iptv_refresh "$pkgdir/usr/bin/couchbox-iptv-refresh"

  # Tile: the desktop file ID matches the window's app ID (org.couchbox.iptv).
  install -Dm644 dist/org.couchbox.iptv.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 assets/org.couchbox.iptv.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"

  # Nightly refresh and 4-hourly guide refresh, on for every user.
  local unit
  for unit in couchbox-iptv-refresh.service couchbox-iptv-refresh.timer couchbox-iptv-guide.service couchbox-iptv-guide.timer; do
    install -Dm644 "dist/systemd/$unit" "$pkgdir/usr/lib/systemd/user/$unit"
  done
  install -d "$pkgdir/usr/lib/systemd/user/timers.target.wants"
  ln -s ../couchbox-iptv-refresh.timer "$pkgdir/usr/lib/systemd/user/timers.target.wants/couchbox-iptv-refresh.timer"
  ln -s ../couchbox-iptv-guide.timer "$pkgdir/usr/lib/systemd/user/timers.target.wants/couchbox-iptv-guide.timer"

  install -Dm644 LICENSE.md -t "$pkgdir/usr/share/licenses/$pkgname/"
}
