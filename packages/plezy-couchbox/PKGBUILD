# Maintainer: Jared Sutton <jpsutton@protonmail.com>
# Based on Arch's extra/plezy by Jonathan Grotelüschen <tippfehlr@archlinux.org>
# Contributor: Mark Wagie <mark dot wagie at proton dot me>
# Contributor: Aburady <accounts@aburady.com>
#
# Plezy with couchbox's patches, until they are accepted upstream (see
# UPSTREAM-BUGS.md, "Plezy pull requests"). A separate name so Arch's plezy
# updates never replace it; it provides and conflicts with plezy. To follow a
# new upstream release: bump pkgver and the source checksum, check the
# patches still apply, and compare with Arch's PKGBUILD:
#   https://gitlab.archlinux.org/archlinux/packaging/packages/plezy

pkgname=plezy-couchbox
_pkgname=plezy
pkgver=2.21.0
pkgrel=1
_flutter_ver=3.47.1
pkgdesc="A modern Plex and Jellyfin client (with couchbox's remote and TV patches)"
provides=("plezy=$pkgver")
conflicts=(plezy)
arch=('x86_64')
url="https://plezy.app"
license=('GPL-3.0-or-later')
depends=(
	'at-spi2-core' 'cairo' 'fontconfig' 'glib2' 'glibc' 'gtk3'
	'hicolor-icon-theme' 'libepoxy' 'libevdev' 'libgcc' 'libstdc++' 'mpv'
	'pango' 'curl' 'zlib' 'libglvnd' 'wayland'
)
makedepends=(
	'chrpath' 'clang' 'fvm' 'git' 'cmake' 'ninja' 'java-environment'
)
source=(
	"$_pkgname::git+https://github.com/edde746/plezy.git#tag=$pkgver"
	"set-flutter-paths.patch"
	"0001-home-key-returns-to-home-tab.patch"
	"0002-linux-play-pause-key-toggles.patch"
	"0003-desktop-display-scale.patch")
sha256sums=('4149afebe063ee083d832bd6d6797f48009f44408f6e37968dfe559bd3bfb3a5'
            '9dfa1088e6401cbaf7a7e925dd6f73428968faa13781cedc621b84820b8245d6'
            'dba8f5eef35376f89df55eea7d765af76c7d5285a4f100b382299e4ad45dd3f1'
            '21e5ebc388c40bac3dfa7b2da88d53aa83825be5dbb32b95b9f721868105a48b'
            'e6186e9fa78e56c4f8e8d1682c1375e9b77607d90b84893a3d1a085a2e7f7be8')

prepare() {
	cd $_pkgname

	# Install flutter_data to /usr/share/
	patch -Np1 -i "$srcdir/set-flutter-paths.patch"
	# couchbox: Home key returns to the Home tab
	patch -Np1 -i "$srcdir/0001-home-key-returns-to-home-tab.patch"
	# couchbox: Play/Pause toggles on Linux (XKB reports it as mediaPlay)
	patch -Np1 -i "$srcdir/0002-linux-play-pause-key-toggles.patch"
	# couchbox: Display Scale setting on desktop (UI too small on a TV)
	patch -Np1 -i "$srcdir/0003-desktop-display-scale.patch"

	export FVM_CACHE_PATH="$srcdir/fvm"
	fvm install $_flutter_ver
	fvm global $_flutter_ver
	fvm flutter --disable-analytics
}

build() {
	cd $_pkgname
	export FVM_CACHE_PATH="$srcdir/fvm"
	fvm flutter build linux --release --dart-define=ENABLE_UPDATE_CHECK=false
}

package() {
	cd $_pkgname

	if [ "$CARCH" == "aarch64" ]; then
		local flutter_arch=arm64
	elif [ "$CARCH" == "x86_64" ]; then
		local flutter_arch=x64
	fi

	# Not required at runtime as it's only used on Android
	rm -fv "build/linux/$flutter_arch/release/bundle/lib/libdartjni.so"

	install -Dm755 "build/linux/$flutter_arch/release/bundle/$_pkgname" -t "$pkgdir/usr/bin/"

	mkdir -p "$pkgdir"/usr/{lib,share}/$_pkgname
	cp -a build/linux/$flutter_arch/release/bundle/data/* "$pkgdir/usr/share/$_pkgname/"
	cp -a build/linux/$flutter_arch/release/bundle/lib/* "$pkgdir/usr/lib/$_pkgname/"
	chmod 0755 "$pkgdir/usr/lib/$_pkgname/crashpad_handler"

	install -Dm644 "linux/packaging/com.edde746.$_pkgname.desktop" -t "$pkgdir/usr/share/applications/"

	# icons
	install -Dm644 "assets/$_pkgname.svg" -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
	install -Dm644 "assets/$_pkgname.png" -t "$pkgdir/usr/share/icons/hicolor/1024x1024/apps/"

	# Set RPATH
	chrpath -r "/usr/lib/$_pkgname" "$pkgdir/usr/bin/$_pkgname"
	chrpath -d "$pkgdir/usr/lib/$_pkgname"/*
}
